### Add Item To Cart
# Auth: Required | Role: Any authenticated user
POST http://localhost:5000/api/carts
Content-Type: application/json
Authorization: Bearer {{ACCESS_TOKEN}}

{
  "productId": "52ECAED6-5902-4B47-96C1-658CB2BF5B09",
  "quantity": 5
}

### Get Cart
# Auth: Required | Role: Any authenticated user
GET http://localhost:5000/api/carts
Authorization: Bearer {{ACCESS_TOKEN}}

### Remove Cart Item
# Auth: Required | Role: Any authenticated user
DELETE http://localhost:5000/api/carts/items/029C9B32-A171-4AB3-B6E7-146AA4C929D3
Authorization: Bearer {{ACCESS_TOKEN}}

### Update Cart Item Quantity
# Auth: Required | Role: Any authenticated user
PUT localhost:5000/api/carts/items/F4E7649E-0518-4661-A53A-46DE8208B583/update-quantity
Content-Type: application/json
Authorization: Bearer {{ACCESS_TOKEN}}

{
  "quantity": 2
}

### Clear Cart
# Auth: Required | Role: Any authenticated user
DELETE localhost:5000/api/carts/items/clear
Authorization: Bearer {{ACCESS_TOKEN}}

### Checkout
# Auth: Required | Role: Any authenticated user
POST http://localhost:5000/api/baskets/checkout
Authorization: Bearer {{ACCESS_TOKEN}}
